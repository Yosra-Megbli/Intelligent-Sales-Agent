# =============================================================================
# Ecofix "Sophie" — variables d'environnement
#
# Copiez ce fichier en `.env` (même dossier que ce fichier, backend/.env) et
# remplissez les valeurs réelles. `database/postgres.py` appelle déjà
# `load_dotenv()` au démarrage, donc un `.env` présent ici est chargé
# automatiquement — aucune configuration supplémentaire n'est nécessaire.
#
# ⚠️ SÉCURITÉ — LIRE AVANT TOUT DÉPLOIEMENT RÉEL :
# api/dependencies.py applique un principe "dev-friendly par défaut" : si
# API_KEY / TELEGRAM_WEBHOOK_SECRET / TWILIO_AUTH_TOKEN ne sont PAS définies,
# les endpoints correspondants tournent SANS authentification (juste un
# warning dans les logs). Cela inclut les endpoints du dashboard, qui
# exposent des données personnelles (PII) sur les leads.
#
# => Les 3 variables marquées [OBLIGATOIRE EN PRODUCTION] ci-dessous DOIVENT
#    être définies avant tout déploiement accessible publiquement.
# =============================================================================


# --- Base de données -----------------------------------------------------
# Doit correspondre aux identifiants définis dans docker-compose.yml
# (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB).
DATABASE_URL=postgresql+psycopg2://ecofix:ecofix@localhost:5432/ecofix_sophie

# --- Redis ------------------------------------------------------------------
# Cache de contexte de conversation, verrous anti-double-traitement,
# rate limiting. Jamais une source de vérité métier.
REDIS_URL=redis://localhost:6379/0


# --- LLM (Groq) ---------------------------------------------------------
# Sans clé, l'API démarre quand même mais Sophie tourne en mode dégradé
# (réponses de secours fixes, sans appel LLM) — voir api/dependencies.py.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# --- Sécurité API ----------------------------------------------------------
# [OBLIGATOIRE EN PRODUCTION] Met "production" ici pour activer un contrôle
# strict au démarrage (api/main.py:_fail_fast_if_misconfigured_for_production) :
# si API_KEY ou TELEGRAM_WEBHOOK_SECRET manquent, l'API refuse de démarrer au
# lieu de tourner sans authentification avec un simple avertissement dans les
# logs (comportement par défaut, conservé pour le développement local).
ENVIRONMENT=

# [OBLIGATOIRE EN PRODUCTION] Protège /api/conversations/* et le dashboard
# (X-API-Key). Générez une valeur forte, ex: `openssl rand -hex 32`.
API_KEY=

# Origines autorisées à appeler l'API depuis un navigateur (CORS), séparées
# par des virgules. Vide = aucune origine autorisée (safe by default).
# Exemple : https://dashboard.ecofix.be,https://app.ecofix.be
CORS_ALLOWED_ORIGINS=


# --- Telegram ---------------------------------------------------------------
# Token du bot, obtenu via @BotFather. Sans lui, les réponses Telegram sont
# calculées mais jamais envoyées (mode "calcul seul").
TELEGRAM_BOT_TOKEN=

# [OBLIGATOIRE EN PRODUCTION] Secret configuré via l'appel setWebhook
# (paramètre secret_token). Vérifie que les appels au webhook viennent bien
# de Telegram.
TELEGRAM_WEBHOOK_SECRET=


# --- Twilio (WhatsApp + Voix) ------------------------------------------
# Depuis la console Twilio (Account SID / Auth Token).
TWILIO_ACCOUNT_SID=
# [OBLIGATOIRE EN PRODUCTION] Sert aussi à vérifier la signature
# X-Twilio-Signature sur le webhook WhatsApp (verify_twilio_signature).
TWILIO_AUTH_TOKEN=
# Numéro WhatsApp fourni par Twilio, format E.164 SANS le préfixe
# "whatsapp:" (celui-ci est ajouté automatiquement par le code).
# Exemple : +14155238886
TWILIO_WHATSAPP_NUMBER=

# --- Twilio Voice (appels sortants / dial-out) -------------------------
# Architecture complète (TelephonyProvider + route /api/voice/outbound-calls),
# NON connectée à un vrai compte Twilio Voice testé dans ce dépôt - voir
# channels/voice/providers/telephony_interface.py. Sans ces 2 variables,
# POST /api/voice/outbound-calls répond 503 (aucun appel n'est jamais
# tenté) plutôt que d'échouer silencieusement.
#
# Numéro vocal Twilio (E.164), distinct de TWILIO_WHATSAPP_NUMBER.
TWILIO_VOICE_NUMBER=

# URL publique de cette API (sans slash final), utilisée pour construire
# l'URL de webhook TwiML que Twilio appelle une fois l'appel décroché
# (voir application/voice_outbound_service.py). Exemple :
# https://api.ecofix.be
PUBLIC_BASE_URL=
