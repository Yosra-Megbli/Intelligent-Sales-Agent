# =============================================================================
# Ecofix "Sophie" — Environment Variables & Cloud Deployment Configuration
# Compatible with Free-Tier Cloud Deployment (Render + Neon + Upstash: 0€/month)
# =============================================================================

# --- Database (Neon Serverless PostgreSQL) -----------------------------------
# Neon free tier gives 0.5 GiB storage and auto-suspends on idle (free).
# Copy the connection string directly from the Neon dashboard.
# Both postgresql:// and postgresql+psycopg2:// prefixes are supported (auto-normalized).
# Example: postgresql://neondb_owner:npg_xyz@ep-hidden-cloud-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Local dev default: postgresql+psycopg2://ecofix:ecofix@localhost:5432/ecofix_sophie
DATABASE_URL=postgresql+psycopg2://ecofix:ecofix@localhost:5432/ecofix_sophie

# --- Redis (Upstash Serverless Redis) ---------------------------------------
# Upstash free tier gives 10,000 commands/day and TLS encryption (free).
# Note: Upstash uses 'rediss://' (with double 's' for TLS/SSL).
# Example: rediss://default:AbCdEf123456@eu1-polished-star-12345.upstash.io:6379
# Local dev default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# --- LLM Provider (Groq) ----------------------------------------------------
# Groq provides fast, free-tier API access for open LLMs.
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Security & Production Gating -------------------------------------------
# Set ENVIRONMENT=production on Render to enforce strict authentication checks.
# If production is set and API_KEY or TELEGRAM_WEBHOOK_SECRET is missing, the
# app will refuse to boot rather than running unauthenticated.
ENVIRONMENT=development

# [REQUIRED IN PRODUCTION] Protects /api/conversations/* and the dashboard (X-API-Key).
# Generate a secure random token, e.g.: `openssl rand -hex 32`
API_KEY=

# Allowed browser CORS origins, separated by commas.
# Render/production frontend domains or local dev origins:
# Example: https://ecofix.be,https://dashboard.ecofix.be,http://localhost:5173
CORS_ALLOWED_ORIGINS=
# Alias:
CORS_ORIGINS=

# Public base URL of your deployed service (without trailing slash).
# Used for constructing public webhook callbacks (Telegram, Twilio, etc.).
# On Render: https://ecofix-sophie-backend.onrender.com
PUBLIC_BASE_URL=

# --- Telegram Bot (Webhook Mode) ---------------------------------------------
# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# [REQUIRED IN PRODUCTION] Secret token configured in Telegram webhook (X-Telegram-Bot-Api-Secret-Token).
# Render webhook endpoint: POST https://<your-render-url>/api/telegram/webhook
# Generate with: `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=
# Alias:
WEBHOOK_SECRET=

# --- Twilio (WhatsApp & Voice Outbound) ---------------------------------------
# Optional: only required for WhatsApp channel and Voice calling features.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VOICE_NUMBER=

# --- RAG v2 (docs/RAG_BACKLOG.md) -------------------------------------------
# Optional: only required to run rag_v2/ingest.py against a real embedding
# API. Nothing in the test suite needs this - every RAG v2 test injects a
# fake EmbeddingProvider. Cost so far: €0 (nothing has been ingested with a
# real key yet).
# Google AI free tier: obtain a key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
RAG_EMBEDDING_MODEL=models/text-embedding-004
RAG_TOP_K=20
RAG_MIN_SIMILARITY=0.30
